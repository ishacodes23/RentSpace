{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Prometheus Target Health (All Targets Must Show UP = 1)",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"rentspace_actuator\"}",
          "legendFormat": "RentSpace Spring Boot App",
          "refId": "A"
        },
        {
          "expr": "up{job=\"node_exporter\"}",
          "legendFormat": "Host (Node Exporter)",
          "refId": "B"
        },
        {
          "expr": "up{job=\"cadvisor\"}",
          "legendFormat": "Containers (cAdvisor)",
          "refId": "C"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN (0)"
                },
                "1": {
                  "color": "green",
                  "text": "UP (1)"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "title": "Host System Resource Usage (Node Exporter)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "Host CPU Utilization (%)",
          "refId": "A"
        },
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "Host RAM Usage (%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 3,
      "title": "Container Metrics (cAdvisor)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"rentspace-app|rentspace-mysql\"}[1m])) * 100",
          "legendFormat": "CPU %: {{name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (name) (container_memory_usage_bytes{name=~\"rentspace-app|rentspace-mysql\"}) / (1024 * 1024)",
          "legendFormat": "RAM (MB): {{name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "title": "Application Performance & JVM Metrics (Spring Boot Actuator)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", application=\"rentspace\"}) / (1024 * 1024)",
          "legendFormat": "JVM Heap Used (MB)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"rentspace\"}[1m]))",
          "legendFormat": "HTTP Request Rate (req/sec)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["rentspace", "monitoring"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "RentSpace Live Performance & Health Dashboard",
  "uid": "rentspace-live-dashboard",
  "version": 1
}
